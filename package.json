{
  "name": "pi-openai-server-compaction",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Pi extension for OpenAI server-side compaction with Codex-quality continuity.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderDoubleflower/pi-openai-server-compaction.git"
  },
  "homepage": "https://github.com/CoderDoubleflower/pi-openai-server-compaction#readme",
  "bugs": {
    "url": "https://github.com/CoderDoubleflower/pi-openai-server-compaction/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "openai",
    "responses",
    "compaction",
    "codex"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "tests",
    "docs",
    "README.md",
    "ARCHITECTURE.md",
    "TESTPLAN.md",
    "VALIDATION.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <0.85.0",
    "@earendil-works/pi-ai": ">=0.84.2 <0.85.0",
    "@earendil-works/pi-agent-core": ">=0.84.2 <0.85.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    }
  },
  "scripts": {
    "smoke:cache": "node --experimental-strip-types ./scripts/cache-payload-smoke.mjs",
    "smoke:v2": "node --experimental-strip-types ./scripts/remote-compaction-v2-smoke.mjs",
    "smoke:midrun": "node --experimental-strip-types ./scripts/mid-run-compaction-smoke.mjs",
    "smoke": "npm run smoke:cache && npm run smoke:v2 && npm run smoke:midrun && node --experimental-strip-types ./scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run smoke",
    "test:live": "node --experimental-strip-types ./tests/live/openai-compaction-rpc-live.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
